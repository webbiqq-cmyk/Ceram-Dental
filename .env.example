###############################################################################
# Ceram Dental — environment variables
#
# Local/demo: copy nothing. The app runs in-memory with login disabled.
# Production: set these on the Render service (API) and Vercel project
# (frontend). NOTHING here is bundled into the client except META values
# noted below. Never commit a filled-in copy of this file.
###############################################################################

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=10000                      # Render sets this automatically; leave unset there
HOST=0.0.0.0                    # bind all interfaces on Render

# Production stays LOCKED unless one of these is true:
#   REQUIRE_LOGIN=true  + DATABASE_URL + JWT_SECRET  (real deployment)
#   DEMO_MODE=true                                   (in-memory walkthrough only)
REQUIRE_LOGIN=true
DEMO_MODE=false

# --- Auth / sessions -------------------------------------------------------- #
JWT_SECRET=                     # REQUIRED. 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=                 # optional alias / rotation slot (JWT_SECRET is authoritative)
SESSION_TTL_HOURS=12
REMEMBER_TTL_DAYS=30
COOKIE_DOMAIN=.cerampro.com     # share the session cookie across *.cerampro.com subdomains
ADMIN_MFA_ENFORCED=false        # set true once TOTP verification is implemented (mfa.service.js)

# --- Database (Render PostgreSQL) ------------------------------------------- #
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ceram?sslmode=require
DATABASE_CA_CERT=              # optional: PEM string if using a private CA
DB_POOL_MAX=5

# --- Public URLs / subdomains -------------------------------------------------
# Used for CORS, e-mail links, and hostname-based section routing.
WEB_URL=https://www.cerampro.com
PORTAL_URL=https://portal.cerampro.com
ADMIN_URL=https://admin-private.cerampro.com
LAB_URL=https://lab-private.cerampro.com
API_URL=https://api.cerampro.com

# Hostnames per section (defaults derived from the *_URL values above; set
# only if they differ from the URL host).
# WEB_HOST=www.cerampro.com
# PORTAL_HOST=portal.cerampro.com
# ADMIN_HOST=admin-private.cerampro.com
# LAB_HOST=lab-private.cerampro.com

# --- CORS ------------------------------------------------------------------- #
# Browser origins allowed to call the API with credentials. Defaults to the
# WEB/PORTAL/ADMIN/LAB URLs above; override with an explicit comma list.
# CORS_ORIGINS=https://www.cerampro.com,https://portal.cerampro.com,https://admin-private.cerampro.com,https://lab-private.cerampro.com

# --- Proxy / Cloudflare --------------------------------------------------------
# 'cloudflare' -> trust ONLY verified Cloudflare edge IPs, then use CF-Connecting-IP
# <number>     -> that many reverse-proxy hops (e.g. 1 for Render alone)
# 'false'      -> direct connections only
TRUST_PROXY=cloudflare
# BEHIND_CLOUDFLARE=true        # alternative flag if TRUST_PROXY is numeric
# CLOUDFLARE_IPS=               # override the bundled CF ranges (comma CIDRs) if CF changes them

# --- LAB STUDIO network lock ------------------------------------------------- #
# Comma/space separated IPv4/IPv6 or CIDR. Lab Studio backend routes return
# 403 unless the request's real client IP matches. Add the clinic's static
# public IP here later — no code change.
CLINIC_IP_ALLOWLIST=
LAB_IP_ENFORCED=               # blank = auto-enforce when CLINIC_IP_ALLOWLIST is non-empty

# --- Cloudinary (media / case files) --------------------------------------- #
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# A size-limited, resource_type=raw+image, type=authenticated unsigned preset
# for case scans/photos (private storage; downloads are short-lived signed URLs).
CLOUDINARY_CASE_UPLOAD_PRESET=ceram_case_authenticated

# --- SMTP (server-side only — never in the frontend) ---------------------- #
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false              # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ceram Dental <no-reply@cerampro.com>"

# --- Frontend (Vercel) — the ONLY value that reaches the browser ---------- #
# Put this in public/index.html <meta name="ceram-api" content="..."> (or a
# Vercel rewrite). Empty = API is same-origin.
#   CERAM_API_BASE=https://api.cerampro.com
